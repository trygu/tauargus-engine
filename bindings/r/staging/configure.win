#!/bin/sh
# tauargusengine: build the bundled native sources (see configure.R).
#
# Runs during R CMD INSTALL on Windows, before the package C++ is
# compiled. R CMD INSTALL executes this as a shell script (Rtools sh)
# with R's own bin directory (Rscript) and the Rtools toolchain on
# PATH.
set -e

exec Rscript configure.R "$@"
