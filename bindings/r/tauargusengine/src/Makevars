# tauargusengine build flags.
#
# The package lives at <engine>/bindings/r/tauargusengine, so from src/ the
# engine root is four levels up. It links the prebuilt native libs from
# <engine>/engine/build/lib (produced by the tauargus-engine superbuild) plus
# HiGHS. (R 4.6+ compiles package C++ with its default standard, C++20, which
# is compatible with the engine's C++11 headers.)

TA_ENGINE := $(abspath ../../../..)
TA_LIB := $(TA_ENGINE)/engine/build/lib
TA_CORE_INC := $(TA_ENGINE)/engine/native/core/src
TA_CSP_INC := $(TA_ENGINE)/engine/native/csp/src
TA_HITAS_INC := $(TA_ENGINE)/engine/native/hitas/src
TA_ROUNDER_INC := $(TA_ENGINE)/engine/native/rounder/src

# Windows detection: on Windows the OS environment variable is
# Windows_NT and GNU make imports environment variables as variables;
# uname is not always on the R CMD INSTALL path, so check both.
UNAME := $(shell uname -s 2>/dev/null)
ifeq ($(UNAME),Windows_NT)
IS_WINDOWS := 1
else ifeq ($(OS),Windows_NT)
IS_WINDOWS := 1
endif

ifneq ($(IS_WINDOWS),)
# Windows CI builds the engine superbuild with the Visual Studio
# generator (multi-config, the same recipe the Python binding and the
# pytauargus wheel build assume): import libs in build/lib/Release,
# runtime DLLs in build/bin/Release. R compiles the package with
# Rtools' GNU make and MinGW; the binding only touches the engine's
# extern "C" API (see the note in rta_csp.cpp), so the MSVC import
# libs link across that boundary. HiGHS is statically linked into the
# engine DLLs, so there is no separate HiGHS dependency here. The
# runtime DLLs (build/bin/Release) must be on PATH when the binding
# is loaded.
PKG_CPPFLAGS = -I"$(TA_CORE_INC)" -I"$(TA_CSP_INC)" -I"$(TA_HITAS_INC)" -I"$(TA_ROUNDER_INC)"
PKG_LIBS = -L"$(TA_LIB)/Release" -l:tauargus_csp.lib -l:tauargus_hitas.lib -l:tauargus_rounder.lib -l:CRP.lib -l:tauargus_core.lib
else ifeq ($(UNAME),Darwin)
# HIGHSPREFIX may be set in the environment (CI builds HiGHS into a
# temp prefix); otherwise fall back to the Homebrew install.
HIGHSPREFIX ?= $(shell brew --prefix highs 2>/dev/null)
ifeq ($(HIGHSPREFIX),)
HIGHSPREFIX := /opt/homebrew/opt/highs
endif
PKG_CPPFLAGS = -I$(TA_CORE_INC) -I$(TA_CSP_INC) -I$(TA_HITAS_INC) -I$(TA_ROUNDER_INC) -I$(HIGHSPREFIX)/include/highs
PKG_LIBS = -L$(TA_LIB) -ltauargus_csp -ltauargus_hitas -ltauargus_rounder -lCRP -ltauargus_core -L$(HIGHSPREFIX)/lib -lhighs -Wl,-rpath,$(TA_LIB) -Wl,-rpath,$(HIGHSPREFIX)/lib
else
# Linux. HIGHSPREFIX may be set in the environment (CI builds HiGHS
# into a temp prefix); otherwise fall back to pkg-config / system.
HIGHSPREFIX ?= $(shell pkg-config --variable=prefix highs 2>/dev/null)
ifeq ($(HIGHSPREFIX),)
HIGHSPREFIX := /usr
endif
PKG_CPPFLAGS = -I$(TA_CORE_INC) -I$(TA_CSP_INC) -I$(TA_HITAS_INC) -I$(TA_ROUNDER_INC) -I$(HIGHSPREFIX)/include/highs
# Statically link the C++ runtime: the binding must not depend on the host
# libstdc++ version (the release binaries target older distros). The
# --exclude-libs options keep the embedded runtime's symbols local; if
# exported, another C++ runtime in the same R session would bind to them
# and the two runtimes would corrupt each other. One -Wl per archive,
# because the GCC driver splits -Wl, lists on commas.
PKG_LIBS = -L$(TA_LIB) -ltauargus_csp -ltauargus_hitas -ltauargus_rounder -lCRP -ltauargus_core -L$(HIGHSPREFIX)/lib -lhighs -Wl,-rpath,$(TA_LIB) -Wl,-rpath,$(HIGHSPREFIX)/lib -static-libstdc++ -static-libgcc -Wl,--exclude-libs,libstdc++.a -Wl,--exclude-libs,libsupc++.a -Wl,--exclude-libs,libgcc.a -Wl,--exclude-libs,libgcc_eh.a
endif
